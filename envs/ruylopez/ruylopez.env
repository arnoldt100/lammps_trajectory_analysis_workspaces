#! /usr/bin/env bash

# The project top level is 2 directory level up from this file.

# Define a temporary environmental variable for the absolute path to the parent directory of
# this file.
TMP_PARENT_DIR=$(dirname "$(realpath "${BASH_SOURCE[0]}")")

# Define an environmental variable for the absolute path to the package top level directory.
export LTAW_TOP_LEVEL=$(dirname "$(realpath "${TMP_PARENT_DIR}/..")")

# Define a temporary environmental variable for the absolute path to the 
# core runtime environmental file.
export TMP_CORE_ENV_FILE=$(realpath "${LTAW_TOP_LEVEL}/envs/core.env")

# Souce the core environmental file.
source ${TMP_CORE_ENV_FILE}

# Unset temporary environmental variables.
unset TMP_PARENT_DIR
unset TMP_CORE_ENV_FILE
