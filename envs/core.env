#! /usr/bin/env bash

export PYTHON_GIL=0

# Define the path to the Python .venv directory.
export LTAW_PYTHON_VENV=${LTAW_TOP_LEVEL}/.venv

# Modify the PYTHONPATH
export PYTHONPATH="${LTAW_TOP_LEVEL}/src:${PYTHONPATH}"

# Modify the PATH variable to include the top level scripts.
export PATH="${LTAW_TOP_LEVEL}/scripts"

# The command 'uv run' can locate the Python virtual environment if the
# environmental variable 'VIRTUAL_ENV' is set to 'LTAW_PYTHON_VENV'.
#
# export VIRTUAL_ENV=${LTAW_PYTHON_VENV}
