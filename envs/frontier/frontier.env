#! /usr/bin/env bash

# Set the machine name
export LTAT_MACHINE='frontier'

# The project top level is 2 directory level up from this file.

# Define a temporary environmental variable for the absolute path to the parent directory of
# this file.
TMP_PARENT_DIR=$(dirname "$(realpath "${BASH_SOURCE[0]}")")

# Define an environmental variable for the absolute path to the package top level directory.
export LTAW_TOP_LEVEL=$(dirname "$(realpath "${TMP_PARENT_DIR}/..")")

# Define a temporary environmental variable for the absolute path to the 
# core runtime environmental file.
export TMP_CORE_ENV_FILE=$(realpath "${LTAW_TOP_LEVEL}/envs/core.env")

# Set TMP_MDA_RESTORE_AFFINITY=1 (or "true"/"yes") in the job environment to
# preserve and restore the scheduler-assigned CPU affinity mask after
# importing MDAnalysis. Prevent underlying OpenMP/BLAS libraries from
# restricting worker threads to a single core on HPC workload managers.
export TMP_MD_RESTORE_AFFINITY="1"

# Define a variable for the computational filesystem workspace for 
# doing the trajectory analysis.
export LTAW_SCRATCH_SPACE="${STF006_MEMBERWORK}/ltaw_workspace"

# Define the environmental variable for the path
# to this project Frontier's Python virtual environment.
export LTAW_PYTHON_VENV="${AT_PYTHON_VENV}/${LTAT_MACHINE}-ltaw-venv"

# Souce the core environmental file.
source ${TMP_CORE_ENV_FILE}

# Unset temporary environmental variables.
unset TMP_PARENT_DIR
unset TMP_CORE_ENV_FILE
unset TMP_MD_RESTORE_AFFINITY
